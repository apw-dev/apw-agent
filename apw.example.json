{
  "workspace": ".",
  "providers": {
    "claude-sonnet": {
      "type": "api",
      "endpoint": "https://api.anthropic.com",
      "model": "claude-sonnet-4-20250514",
      "api_key_env": "ANTHROPIC_API_KEY",
      "timeout_sec": 120
    },
    "claude-haiku": {
      "type": "api",
      "endpoint": "https://api.anthropic.com",
      "model": "claude-3-5-haiku-latest",
      "api_key_env": "ANTHROPIC_API_KEY",
      "timeout_sec": 60
    },
    "ollama-local": {
      "type": "local",
      "endpoint": "http://127.0.0.1:11434",
      "model": "qwen2.5-coder:7b",
      "timeout_sec": 120
    }
  },
  "roles": {
    "architect": "claude-sonnet",
    "reflex": "claude-haiku"
  },
  "failover": {
    "reflex": [],
    "architect": [],
    "directive_timeout_sec": 90
  },
  "budget": {
    "max_repairs": 3,
    "task_timeout_sec": 600
  },
  "policy": {
    "trusted": false
  },
  "retention": {
    "succeeded_days": 14,
    "failed_days": 30,
    "outbox_sent_days": 7,
    "inbox_keep": 1000,
    "log_max_mb": 8,
    "auto_cleanup": false
  },
  "sandbox": {
    "mode": "off",
    "network": "install"
  },
  "research": {
    "enabled": false
  },
  "planning": {
    "proposals": 1,
    "judge": false
  }
}
